PORT=3000
NODE_ENV=development

# Cambia a false cuando tengas credenciales reales de Twilio.
USE_TWILIO_DEMO=true

# Activa este canal solo si quieres reenviar tambien por WhatsApp.
ENABLE_WHATSAPP_FALLBACK=false

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# En sandbox suele ser algo como whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# Numero interno que recibira la alerta, formato E.164 con prefijo whatsapp:
# whatsapp:+573001112233
TWILIO_WHATSAPP_TO=

# Opcional pero recomendado para mensajes fuera de la ventana de 24 horas.
# Se obtiene en Twilio Console > Messaging > Content Template Builder.
TWILIO_CONTENT_SID=

# Opcional. Si usas Messaging Service para enviar plantillas.
TWILIO_MESSAGING_SERVICE_SID=

# Opcional. URL publica HTTPS para recibir callbacks de estado.
TWILIO_STATUS_CALLBACK_URL=

# Mensaje base del negocio
CAFE_NAME=Quinayas Cafe

# En segundos, para evitar multiples llamados casi simultaneos desde una misma mesa
TABLE_CALL_COOLDOWN_SECONDS=45
